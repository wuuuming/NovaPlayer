// Desktop lyrics (novaplayer-spec.md, "Desktop lyrics"): the sung line and the one under it on a
// plate over every window. The overlay is sized to `#content`, laid out on a stage as wide as
// the display's work area (`$stage`), not the window, so the window can follow it
// (views/desktop_lyrics.rs). The look follows LyricsX's desktop lyrics: a plate fitting the
// lines, its radius half the font size, padding one font size across and a third down, lines a
// third apart.

let size = $size;
let border = max(1, size / 24);

style bar-btn { width: 30; height: 30; radius: 6; icon-size: 16; fg: #FFFFFF; bg-hover: #26FFFFFF; bg-press: #14FFFFFF; }

Box #root { width: 100%; height: 100%;
  Column #stage { position: absolute; left: window.w / 2 - $stage / 2; width: $stage; bottom: 0; align: center;
    Column #content { align: center; gap: 6; hit: true; hover-events: true;
      // The pointer over it shows these, locked or not (locked, presses pass through all else).
      Row #bar { height: 34; padding: 0, 2; gap: 2; radius: 8; bg: #99000000; align: center; opacity: 0; hover-events: true;
        Button #lock .bar-btn { icon: LockClosed; on-click: lock; }
        Button #prev .bar-btn { icon: PreviousFilled; on-click: prev; }
        Button #play .bar-btn { icon: PlayFilled; on-click: play-pause; }
        Button #next .bar-btn { icon: NextFilled; on-click: next; }
        Button #smaller .bar-btn { icon: FontDecrease; on-click: smaller; }
        Button #larger .bar-btn { icon: FontIncrease; on-click: larger; }
        Button #close .bar-btn { icon: Dismiss; on-click: "set:desktop-lyrics:off"; }
      }
      Column #plate { padding: size / 3, size; radius: size / 2; bg: $plate; align: center;
        // Unlocked, the pointer over it shows at least a light plate: where it can be dragged.
        Box #wash { position: absolute; left: 0; top: 0; right: 0; bottom: 0; radius: size / 2; bg: $wash; opacity: 0; }
        Column #lines { align: center; gap: size / 3;
          // White, the sung part swept in the lyrics' colour word by word where every line is stamped
          // so; other lyrics have the line in it whole.
          // A border, not a glow, keeps it legible over any background.
          // A line wider than the stage wraps (two rows at most), as the lyrics page's do.
          Text #line { text: $line; max-width: $stage - 2 * size; lines: 2; font-size: size; line: round(size * 1.3); weight: 600; fg: #FFFFFF; text-align: center;
                       sweep: $sweep; sweep-fg: $colour; units: char; u-outline: border, #000000, 0.6; }
          Text #second { text: $second; max-width: $stage - 2 * size; lines: 2; font-size: size; line: round(size * 1.3); weight: 600; fg: #FFFFFF; text-align: center;
                         fg-alpha: $second-alpha; shown: $has-second; units: char; u-outline: border, #000000, 0.6; }
        }
      }
    }
  }
}
