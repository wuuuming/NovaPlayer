<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded in the Windows program (build.rs). The segment heap gives freed memory back to the
     system; the default heap kept it committed, fragmented by each song's buffers of every size,
     and the program grew with every song played. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
